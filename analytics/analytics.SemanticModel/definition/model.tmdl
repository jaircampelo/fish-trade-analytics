annotation PBI_QueryOrder = ["dim_cities","dim_countries","dim_product_categories","fact_trades","dim_calendario"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode","DaxQueryView_Desktop"]

ref table dim_cities
ref table dim_countries
ref table dim_product_categories
ref table fact_trades
ref table dim_calendario
ref table Tipo
ref table TopN

ref cultureInfo pt-BR

