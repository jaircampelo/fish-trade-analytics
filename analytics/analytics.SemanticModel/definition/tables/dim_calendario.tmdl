	column TrimestreFiscalAtual
		dataType: string
		displayFolder: TrimestreFiscal
		lineageTag: 07cab2e1-b2dd-483a-a94c-a311deb5937a
		summarizeBy: none
		sourceColumn: TrimestreFiscalAtual
		sortByColumn: AnoTrimestreFiscalNumero

