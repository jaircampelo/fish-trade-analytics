	measure 'B - Subtitulo Card Exportacoes' = ```
			
			VAR __MaiorEstadoTab =
			    INDEX(
			        1,
			        ALLSELECTED(dim_cities[state_name]),
			        ORDERBY([$ Exportacoes], DESC)
			    )
			VAR __MaiorEstadoNome =
			    CONCATENATEX(__MaiorEstadoTab, dim_cities[state_name])
			VAR __TabMaiorEstadoComValor =
			    ADDCOLUMNS(
			        ALLSELECTED(dim_cities[state_name]),
			        "@Valor",
			        [$ Exportacoes],
			        "@Peso",
			        [# Peso Líquido Exportacoes]
			    )
			VAR __MaiorEstadoValor =
			    MAXX(
			        TOPN(1, __TabMaiorEstadoComValor, [@Valor], DESC),
			        [@Valor]
			    )
			VAR __FormatMaiorEstadoValor =
			    SWITCH(
			        TRUE(),
			        ABS(__MaiorEstadoValor) > 1000000000, FORMAT(__MaiorEstadoValor, "#0,,,.00 Bi"),
			        ABS(__MaiorEstadoValor) > 1000000, FORMAT(__MaiorEstadoValor, "#0,,.00 Mi"),
			        ABS(__MaiorEstadoValor) > 1000, FORMAT(__MaiorEstadoValor, "#0,.00 K"),
			        FORMAT(__MaiorEstadoValor, "#0")
			    )
			VAR __MaiorEstadoPeso =
			    MAXX(
			        TOPN(1, __TabMaiorEstadoComValor, [@Peso], DESC),
			        [@Peso]
			    )
			VAR __FormatMaiorEstadoPeso =
			    SWITCH(
			        TRUE(),
			        ABS(__MaiorEstadoPeso) >= 1000, FORMAT(__MaiorEstadoPeso, "#,#0,.00 Ton"),
			        FORMAT(__MaiorEstadoPeso, "#0 Kg")
			    )
			
			VAR __Data =
			ALLSELECTED(dim_calendario[MesAnoNome], dim_calendario[MesAnoNumero])
			VAR __MinNumero = 
			MINX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendario[MesAnoNumero]
			)
			VAR __MaxNumero = 
			MAXX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendario[MesAnoNumero]
			)
			VAR __MinNome = 
			MAXX(
			    FILTER(__Data, dim_calendario[MesAnoNumero] = __MinNumero), 
			    dim_calendario[MesAnoNome]
			)
			VAR __MaxNome = 
			MAXX(
			    FILTER(__Data, dim_calendario[MesAnoNumero] = __MaxNumero), 
			    dim_calendario[MesAnoNome]
			)
			
			VAR __Texto =
			    "Foi o estado que mais exportou pescado no período de "
			    & __MinNome & " - " & __MaxNome
			    & ", acumulando o valor de "
			    & __FormatMaiorEstadoValor
			    & " de dólares e um volume total de "
			    & __FormatMaiorEstadoPeso & "."
			RETURN
			__Texto
			```
		displayFolder: Medidas\07. Storytelling
		lineageTag: 6ae60983-8e9b-4c8f-ade0-1054236e2850

		changedProperty = IsHidden

	measure 'B - Subtitulo Card Importacoes' = ```
			
			VAR __MaiorEstadoTab =
			    INDEX(
			        1,
			        ALLSELECTED(dim_cities[state_name]),
			        ORDERBY([$ Importacoes], DESC)
			    )
			VAR __MaiorEstadoNome =
			    CONCATENATEX(__MaiorEstadoTab, dim_cities[state_name])
			VAR __TabMaiorEstadoComValor =
			    ADDCOLUMNS(
			        ALLSELECTED(dim_cities[state_name]),
			        "@Valor",
			        [$ Importacoes],
			        "@Peso",
			        [# Peso Líquido Importacoes]
			    )
			VAR __MaiorEstadoValor =
			    MAXX(
			        TOPN(1, __TabMaiorEstadoComValor, [@Valor], DESC),
			        [@Valor]
			    )
			VAR __FormatMaiorEstadoValor =
			    SWITCH(
			        TRUE(),
			        ABS(__MaiorEstadoValor) > 1000000000, FORMAT(__MaiorEstadoValor, "#0,,,.00 Bi"),
			        ABS(__MaiorEstadoValor) > 1000000, FORMAT(__MaiorEstadoValor, "#0,,.00 Mi"),
			        ABS(__MaiorEstadoValor) > 1000, FORMAT(__MaiorEstadoValor, "#0,.00 K"),
			        FORMAT(__MaiorEstadoValor, "#0")
			    )
			VAR __MaiorEstadoPeso =
			    MAXX(
			        TOPN(1, __TabMaiorEstadoComValor, [@Peso], DESC),
			        [@Peso]
			    )
			VAR __FormatMaiorEstadoPeso =
			    SWITCH(
			        TRUE(),
			        ABS(__MaiorEstadoPeso) >= 1000, FORMAT(__MaiorEstadoPeso, "#,#0,.00 Ton"),
			        FORMAT(__MaiorEstadoPeso, "#0 Kg")
			    )
			
			VAR __Data =
			ALLSELECTED(dim_calendario[MesAnoNome], dim_calendario[MesAnoNumero])
			VAR __MinNumero = 
			MINX(
			    FILTER(__Data, [$ Importacoes] > 0), 
			    dim_calendario[MesAnoNumero]
			)
			VAR __MaxNumero = 
			MAXX(
			    FILTER(__Data, [$ Importacoes] > 0), 
			    dim_calendario[MesAnoNumero]
			)
			VAR __MinNome = 
			MAXX(
			    FILTER(__Data, dim_calendario[MesAnoNumero] = __MinNumero), 
			    dim_calendario[MesAnoNome]
			)
			VAR __MaxNome = 
			MAXX(
			    FILTER(__Data, dim_calendario[MesAnoNumero] = __MaxNumero), 
			    dim_calendario[MesAnoNome]
			)
			
			VAR __Texto =
			    "por outro lado, foi o estado que mais importou pescado para o mesmo período, acumulando o valor de "
			    & __FormatMaiorEstadoValor
			    & " de dólares e um volume total de "
			    & __FormatMaiorEstadoPeso & "."
			RETURN
			__Texto
			```
		displayFolder: Medidas\07. Storytelling
		lineageTag: a4bbb62b-ee5e-438c-93fb-8087e05b1bef

		changedProperty = IsHidden

	measure 'B - Titulo Top Municipios Exportacoes' = ```
			
			VAR __TopN = [TopN Value]
			VAR __Data =
			ALLSELECTED(dim_calendario[MesAnoNome], dim_calendario[MesAnoNumero])
			VAR __MinNumero = 
			MINX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendario[MesAnoNumero]
			)
			VAR __MaxNumero = 
			MAXX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendario[MesAnoNumero]
			)
			VAR __MinNome = 
			MAXX(
			    FILTER(__Data, dim_calendario[MesAnoNumero] = __MinNumero), 
			    dim_calendario[MesAnoNome]
			)
			VAR __MaxNome = 
			MAXX(
			    FILTER(__Data, dim_calendario[MesAnoNumero] = __MaxNumero), 
			    dim_calendario[MesAnoNome]
			)
			VAR __Texto =
			    "Exibindo os "
			    & __TopN
			    & " estados que mais exportaram pescado no período de "
			    & __MinNome & " - " & __MaxNome
			
			RETURN
			    __Texto
			```
		displayFolder: Medidas\07. Storytelling
		lineageTag: ecc3c6c2-4f17-4b7d-8370-2f99919c2b69

		changedProperty = IsHidden

	measure 'B - Subtitulo Top Municipios Exportacoes' =
			
			VAR __MaiorMunTab =
			    INDEX(
			        1,
			        ALLSELECTED(dim_cities[city_uf]),
			        ORDERBY([$ Exportacoes], DESC)
			    )
			VAR __MaiorMunTabValor =
			    ADDCOLUMNS(
			        ALLSELECTED(dim_cities[city_uf]),
			        "@Valor",
			        [$ Exportacoes]
			    )
			VAR __MaiorMunNome =
			    CONCATENATEX(__MaiorMunTab, dim_cities[city_uf])
			VAR __MaiorMunValor =
			MAXX(
			    TOPN(1, __MaiorMunTabValor, [@Valor], DESC),
			    [@Valor]
			)
			VAR __FormarMaiorMunValor =
			    SWITCH(
			        TRUE(),
			        ABS(__MaiorMunValor) > 1000000000, FORMAT(__MaiorMunValor, "#0,,,.00 Bi"),
			        ABS(__MaiorMunValor) > 1000000, FORMAT(__MaiorMunValor, "#0,,.00 Mi"),
			        ABS(__MaiorMunValor) > 1000, FORMAT(__MaiorMunValor, "#0,.00 K"),
			        FORMAT(__MaiorMunValor, "#0")
			    )
			
			VAR __Texto =
			    __MaiorMunNome
			    & " se destaca como o maior exportador de pescado (U$ "
			    & __FormarMaiorMunValor
			    & ") para o período selecionado."
			
			RETURN
			__Texto
		displayFolder: Medidas\07. Storytelling
		lineageTag: b37aafe0-622e-4dde-98cc-e679e2b36580

		changedProperty = IsHidden

	measure 'B - Subtitulo Municipios Ativos Exportacoes' =
			
			VAR __TopStateTab =
			    ADDCOLUMNS(
			        ALLSELECTED(dim_cities[state_name]),
