	measure 'PC - Subtitulo HHI' =
			
			VAR __HHIInicio =
			    CALCULATE(
			        [% HHI Pais Dinamico],
			        FILTER(
			            ALL(dim_calendario),
			            dim_calendario[Ano] = MIN(dim_calendario[Ano])
			        )
			    )
			
			VAR __HHIFim =
			    CALCULATE(
			        [% HHI Pais Dinamico],
			        FILTER(
			            ALL(dim_calendario),
			            dim_calendario[Ano] = MAX(dim_calendario[Ano])
			        )
			    )
			
			VAR __Variacao = __HHIFim - __HHIInicio
			
			VAR __AnoInicio = MIN(dim_calendario[Ano])
			VAR __AnoFim = MAX(dim_calendario[Ano])
			
			VAR __TextoDinamico =
			    IF(
			        __Variacao < 0,
			        "o mercado se diversificou " & FORMAT(ABS(__Variacao), "#0.0%") & " desde " & __AnoInicio,
			        "a concentração aumentou " & FORMAT(__Variacao, "#0.0%") & " desde " & __AnoInicio
			    )
			
			VAR __TextoFinal =
			    "HHI: índice de concentração de mercado (quanto maior, mais dependente de poucos parceiros) indica que "
			    & __TextoDinamico
			
			RETURN
			    __TextoFinal
		displayFolder: Medidas\07. Storytelling
		lineageTag: b42d4cec-6299-46de-ade2-901ecad902fc

		changedProperty = IsHidden

