	measure 'VG - Subtitulo Visual Serie Historica' = ```
			
			VAR __MaxImp =
			MAXX(
			    ALL(dim_calendario[MesAnoNome]),
			    [$ Importacoes]
			)
			
			VAR __MaxData = 
			TOPN(
			    1,
			    ALL(dim_calendario[MesAnoNome]),
			    [$ Importacoes], DESC
			)
			VAR __MaxDataEscalar =
			CONCATENATEX(__MaxData, dim_calendario[MesAnoNome])
			
			VAR __FormatMax =
			SWITCH(
			    TRUE(),
			    __MaxImp > 1000000000, FORMAT(__MaxImp, "#0,,,.00 Bi"),
			    __MaxImp > 1000000, FORMAT(__MaxImp, "#0,,.00 Mi"),
			    __MaxImp > 1000, FORMAT(__MaxImp, "#0,.00 K"),
			    FORMAT(__MaxImp, "#0")
			)
			
			VAR __Texto =
			"O Brasil se destaca como um importador líquido de pescado, atingindo a máxima histórica de "
			& __FormatMax
			& " de dólares em "
			& __MaxDataEscalar
			
			RETURN
			__Texto
			```
		displayFolder: Medidas\07. Storytelling
		lineageTag: f2185dff-d2f9-4a34-80fb-73bbabe5991e

	measure '$ Exportacoes Acc por Produto' =
			
			VAR __Window =
			WINDOW(
			    1, ABS,
			    0, REL,
			    ALLSELECTED(dim_product_categories[product_category_name]),
			    ORDERBY([$ Exportacoes], DESC)
			)
			
			VAR __Acc =
			CALCULATE(
			    [$ Exportacoes],
			    __Window
			)
			
			RETURN
			__Acc
		displayFolder: Medidas\03. Performance & Preço
		lineageTag: 4be9b1ce-4e3b-44f6-b6b5-baf0b25a2e20

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Exportacoes Pareto' =
			
			VAR __Window =
			WINDOW(
			    1, ABS,
			    -1, ABS,
			    ALLSELECTED(dim_product_categories[product_category_name]),
			    ORDERBY([$ Exportacoes], DESC)
			)
			
			VAR __Total =
			CALCULATE(
			    [$ Exportacoes],
			    __Window
			)
			
			VAR __Result = DIVIDE([$ Exportacoes Acc por Produto], __Total)
			
			RETURN
			__Result
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Medidas\03. Performance & Preço
		lineageTag: ddd85306-482e-4dbd-948e-bd23c1d9c10b

	measure 'VG - Subtitulo Produtos' =
			
			-- Busca todas as categorias
			VAR __TodasCategorias =
			ALLSELECTED(dim_product_categories[product_category_name], dim_product_categories[product_category_id])
			
			-- Extrai o Top 1 e o Top 2 por valor de exportações
			VAR __Top1 =
			TOPN(1, __TodasCategorias, [$ Exportacoes], DESC)
			VAR __SemTop1 =
			EXCEPT(__TodasCategorias, __Top1)
			VAR __Top2 =
			TOPN(1, __SemTop1, [$ Exportacoes], DESC)
			
			-- Assegura um valor escalar para inserir no texto
			VAR __EscalarTop1Nome = CONCATENATEX(__Top1, dim_product_categories[product_category_name])
			VAR __EscalarTop1Id = CONCATENATEX(__Top1, dim_product_categories[product_category_id])
			
			VAR __EscalarTop2Nome = CONCATENATEX(__Top2, dim_product_categories[product_category_name])
			VAR __EscalarTop2Id = CONCATENATEX(__Top2, dim_product_categories[product_category_id])
			
			--Extrai o percentual do Top 1 e do Top 2
			VAR __Top1Percent =
			FORMAT(
			    CALCULATE(
			        [% Participacao no Total Exportacoes],
			        __Top1
			    ),
			    "#0.0%"
			)
			VAR __Top2Percent =
			FORMAT(
			    CALCULATE(
			        [% Participacao no Total Exportacoes],
			        __Top2
			    ),
			    "#0.0%"
			)
			
			VAR __Texto =
			"A categoria "
			& __EscalarTop1Nome & " (" & __EscalarTop1Id & ") domina "
			&  __Top1Percent
			& " do mercado de exportações, seguida de "
			& __EscalarTop2Nome & " (" & __EscalarTop2Id & "), com "
			& __Top2Percent & "."
			
			RETURN
			__Texto
		displayFolder: Medidas\07. Storytelling
		lineageTag: 9f28283c-1368-4703-a02e-c8498b7e3044

	measure 'VG - Titulo Top N Estados' =
			
			VAR __TopNValor = SELECTEDVALUE('aux_topn'[TopN])
			
			VAR __TextoTop1 =
			"Quem é o Top 1 estado que mais exporta?"
			
			VAR __TextoTopMaiorQue1 =
			"Quem são os Top "
			& __TopNValor
			& " estados que mais exportam?"
			
			VAR __Texto =
			IF(
			    __TopNValor > 1,
			    __TextoTopMaiorQue1,
			    __TextoTop1
			)
			
			RETURN
			__Texto
		displayFolder: Medidas\07. Storytelling
		lineageTag: 9e0d4ffb-0855-489b-8c4e-a9757b61bea5

	measure 'VG - Subtitulo Top N Estados' = ```
			
			VAR __Data =
			ALLSELECTED(dim_calendario[MesAnoNome], dim_calendario[MesAnoNumero])
			
			VAR __MinNumero = 
			MINX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendario[MesAnoNumero]
			)
			
			VAR __MaxNumero = 
			MAXX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendario[MesAnoNumero]
			)
			
			VAR __MinNome = 
			MAXX(
			    FILTER(__Data, dim_calendario[MesAnoNumero] = __MinNumero), 
			    dim_calendario[MesAnoNome]
			)
			
			VAR __MaxNome = 
			MAXX(
			    FILTER(__Data, dim_calendario[MesAnoNumero] = __MaxNumero), 
			    dim_calendario[MesAnoNome]
			)
			
			VAR __Texto =
			"Ranking dos estados que mais exportaram, em dólares, no período de "
			& __MinNome & " - " & __MaxNome
			
			RETURN
			__Texto
			```
		displayFolder: Medidas\07. Storytelling
		lineageTag: 1450d53a-519e-4e23-9e5b-b85eec50729d

	measure 'Ranking Exportacoes por Pais' =
			
			RANK(
			    DENSE,
			    ALLSELECTED(aux_paises_outros[country_name]),
			    ORDERBY([$ Exportacoes], DESC)
			)
		formatString: 0
		displayFolder: Medidas\04. Rankings
		lineageTag: e9dcdb97-ed69-40a0-a5fd-54cd7054cdab

	measure 'VG - Titulo Top N Paises' =
			
			VAR __TopNValor = SELECTEDVALUE('aux_topn'[TopN])
			
			VAR __TextoTop1 =
			"Quem é o principal parceiro comercial do Brasil nas exportações?"
			
			VAR __TextoTopMaiorQue1 =
			"Quem são os Top "
			& __TopNValor
			& " parceiros comerciais do Brasil nas exportações?"
			
			VAR __Texto =
			IF(
			    __TopNValor > 1,
			    __TextoTopMaiorQue1,
			    __TextoTop1
			)
			
			RETURN
			__Texto
		displayFolder: Medidas\07. Storytelling
		lineageTag: b41feede-3752-42f8-a499-f5a1c4739491

	measure 'VG - Subtitulo Top N Paises' = ```
			
			------------------------------------------
			-- CALCULANDO VALORES
			------------------------------------------
			VAR __Pais =
			TOPN(
			    1,
			    ALLSELECTED(aux_paises_outros[country_name]),
			    [$ Exportacoes], DESC
			)
			VAR __Valor =
			CALCULATE(
			    [$ Exportacoes],
			    __Pais
			)
			VAR __FormatValor =
			SWITCH(
			    TRUE(),
			    __Valor > 1000000000, FORMAT(__Valor, "#0,,,.00 Bi"),
			    __Valor > 1000000, FORMAT(__Valor, "#0,,.00 Mi"),
			    __Valor > 1000, FORMAT(__Valor, "#0,.00 K"),
			    FORMAT(__Valor, "#0")
			)
			VAR __Pct =
			CALCULATE(
			    [% Participacao no Total Exportacoes],
			    __Pais
			)
			
			------------------------------------------
			-- CALCULANDO RANGE DE DATAS
			------------------------------------------
			VAR __Data =
			ALLSELECTED(dim_calendario[MesAnoNome], dim_calendario[MesAnoNumero])
			VAR __MinNumero = 
			MINX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendario[MesAnoNumero]
			)
			VAR __MaxNumero = 
			MAXX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendario[MesAnoNumero]
			)
			VAR __MinNome = 
			MAXX(
			    FILTER(__Data, dim_calendario[MesAnoNumero] = __MinNumero), 
			    dim_calendario[MesAnoNome]
			)
			VAR __MaxNome = 
			MAXX(
			    FILTER(__Data, dim_calendario[MesAnoNumero] = __MaxNumero), 
			    dim_calendario[MesAnoNome]
			)
			
			VAR __Texto =
			__Pais
			& " lidera as exportações brasileiras de pescado, absorvendo " 
			& FORMAT(__Pct, "0.0%")
			& " do total, equivalente a U$ " 
			& __FormatValor
			& " durante o período de "
			& __MinNome & " - " & __MaxNome
			
			RETURN
			__Texto
			```
		displayFolder: Medidas\07. Storytelling
		lineageTag: d3503ebc-941d-41ea-9cee-36ac7c70951f

	measure 'BC - Titulo Pagina' =
			
			VAR __TopBottomBalanca =
			TOPN(
			    1,
			    ALLSELECTED(dim_calendario[MesAnoNome]),
			    [$ Balanca Comercial], ASC
			)
			VAR __EscalarTopBottom =
			CONCATENATEX(__TopBottomBalanca, dim_calendario[MesAnoNome])
			
			VAR __ValorTopBottom =
			CALCULATE(
			    [$ Balanca Comercial],
			    __TopBottomBalanca
			)
			VAR __FormatValorTopBottom =
			SWITCH(
			    TRUE(),
			    ABS(__ValorTopBottom) > 1000000000, FORMAT(__ValorTopBottom, "#0,,,.00 Bi"),
			    ABS(__ValorTopBottom) > 1000000, FORMAT(__ValorTopBottom, "#0,,.00 Mi"),
			    ABS(__ValorTopBottom) > 1000, FORMAT(__ValorTopBottom, "#0,.00 K"),
			    FORMAT(__ValorTopBottom, "#0")
			)
			
			VAR __Texto =
			"A Balança Comercial de pescado atingiu a mínima histórica em "
			& __EscalarTopBottom
			& ", chegando a "
			& __FormatValorTopBottom
			& " de dólares."
			
			RETURN
			__Texto
		displayFolder: Medidas\07. Storytelling
		lineageTag: 10d9b78f-81b6-4f8f-bb8d-031b8db32a49

	measure 'BC - Subtitulo Nominal vs Real' =
			
			VAR __TodosMeses = ALLSELECTED(dim_calendario[MesAnoNome], dim_calendario[MesAnoNumero])
			
			VAR __TopDiffValor =
			MAXX(
			    FILTER(__TodosMeses, [$ Balança Comercial Real]),
			    ABS([$ Balança Comercial Real] - [$ Balanca Comercial])
			)
			VAR __FormatTopDiffValor =
			SWITCH(
			    TRUE(),
			    __TopDiffValor > 1000000000, FORMAT(__TopDiffValor, "#0,,,.00 Bi"),
			    __TopDiffValor > 1000000, FORMAT(__TopDiffValor, "#0,,.00 Mi"),
			    __TopDiffValor > 1000, FORMAT(__TopDiffValor, "#0,.00 K"),
			    FORMAT(__TopDiffValor, "#0")
			)
			
			VAR __TopDiffMes =
			MAXX(
			    FILTER(__TodosMeses, ABS([$ Balança Comercial Real] - [$ Balanca Comercial]) = __TopDiffValor),
			    dim_calendario[MesAnoNome]
			)
			
			VAR __Texto =
			"Ao comparar o valor nominal da balança comercial com o valor corrigido pela CPI (Consumer Price Index), verificamos que a maior distorção entre o valor nominal e o real foi de "
			& __FormatTopDiffValor
			& " de dólares em "
			& __TopDiffMes & "."
			
			RETURN
			__Texto
		displayFolder: Medidas\07. Storytelling
		lineageTag: 5ce81b44-e0bc-42c9-a700-4792fe234ab3

	measure 'BC - Subtitulo Acumulado' = ```
			
			VAR __TodosAnos = ALLSELECTED(dim_calendario[Ano])
			
			VAR __TradeDiff =
			CALCULATE(
			    ABS([$ Exportacoes Acc] - [$ Importacoes Acc]),
			    __TodosAnos
			)
			VAR __FormatTradeDiff =
			SWITCH(
			    TRUE(),
			    __TradeDiff > 1000000000, FORMAT(__TradeDiff, "#0,,,.00 Bi"),
			    __TradeDiff > 1000000, FORMAT(__TradeDiff, "#0,,.00 Mi"),
			    __TradeDiff > 1000, FORMAT(__TradeDiff, "#0,.00 K"),
			    FORMAT(__TradeDiff, "#0")
			)
			
			VAR __Data =
			ALLSELECTED(dim_calendario[MesAnoNome], dim_calendario[MesAnoNumero])
			VAR __MinNumero = 
			MINX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendario[MesAnoNumero]
			)
			VAR __MaxNumero = 
			MAXX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendario[MesAnoNumero]
			)
			VAR __MinNome = 
			MAXX(
			    FILTER(__Data, dim_calendario[MesAnoNumero] = __MinNumero), 
			    dim_calendario[MesAnoNome]
			)
			VAR __MaxNome = 
			MAXX(
			    FILTER(__Data, dim_calendario[MesAnoNumero] = __MaxNumero), 
			    dim_calendario[MesAnoNome]
			)
			
			VAR __TextoDeficit =
			"Para o peíodo de "
			& __MinNome & " - " & __MaxNome
			& ", o Brasil possui um déficit acumulado de "
			& __FormatTradeDiff & " de dólares."
			VAR __TextoSuperavit =
			"Para o peíodo de "
			& __MinNome & " - " & __MaxNome
			& ", o Brasil possui um superávit acumulado de "
			& __FormatTradeDiff & " de dólares."
			
			RETURN
			IF(
			    [$ Exportacoes Acc] > [$ Importacoes Acc],
			    __TextoSuperavit,
			    __TextoDeficit
			)
			```
		displayFolder: Medidas\07. Storytelling
		lineageTag: a3c40b74-0bf9-4ded-8359-95a509229902

	measure 'BC - Subtitulo Heatmap' = ```
			
			VAR __TabMediaMensal =
			ADDCOLUMNS(
			    ALLSELECTED(dim_calendario[MesNome]),
			    "@MediaMensal",
			    AVERAGEX(
			        ALLSELECTED(dim_calendario[Ano]),
			        [$ Balanca Comercial]
			    )
			)
			
			VAR __MinVal = MINX(__TabMediaMensal, [@MediaMensal])
			VAR __MaxVal = MAXX(__TabMediaMensal, [@MediaMensal])
			VAR __FormatMinVal =
			SWITCH(
			    TRUE(),
			    ABS(__MinVal) > 1000000000, FORMAT(__MinVal, "#0,,,.00 Bi"),
			    ABS(__MinVal) > 1000000, FORMAT(__MinVal, "#0,,.00 Mi"),
			    ABS(__MinVal) > 1000, FORMAT(__MinVal, "#0,.00 K"),
			    FORMAT(__MinVal, "#0")
			)
			VAR __FormatMaxVal =
			SWITCH(
			    TRUE(),
			    ABS(__MaxVal) > 1000000000, FORMAT(__MaxVal, "#0,,,.00 Bi"),
			    ABS(__MaxVal) > 1000000, FORMAT(__MaxVal, "#0,,.00 Mi"),
			    ABS(__MaxVal) > 1000, FORMAT(__MaxVal, "#0,.00 K"),
			    FORMAT(__MaxVal, "#0")
			)
			
			VAR __MesMin = 
			MAXX(
			    FILTER(__TabMediaMensal, [@MediaMensal] = __MinVal),
			    dim_calendario[MesNome]
			)
			VAR __MesMax = 
			MAXX(
			    FILTER(__TabMediaMensal, [@MediaMensal] = __MaxVal),
			    dim_calendario[MesNome]
			)
			
			VAR __Texto =
			__MesMin & " registra o pior saldo médio mensal (" & __FormatMinVal & ") e "
			& __MesMax & " o melhor (" & __FormatMaxVal & ") ao longo dos 20 anos"
			
			RETURN
			__Texto
			```
		displayFolder: Medidas\07. Storytelling
		lineageTag: aeb61735-ec6a-4aea-8f92-81a6605811c8

	measure 'P - Subtitulo Card Mais Exportado' = ```
			
			VAR __Data =
			ALLSELECTED(dim_calendario[MesAnoNome], dim_calendario[MesAnoNumero])
			VAR __MinNumero = 
			MINX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendario[MesAnoNumero]
			)
			VAR __MaxNumero = 
			MAXX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendario[MesAnoNumero]
			)
			VAR __MinNome = 
			MAXX(
			    FILTER(__Data, dim_calendario[MesAnoNumero] = __MinNumero), 
			    dim_calendario[MesAnoNome]
			)
			VAR __MaxNome = 
			MAXX(
			    FILTER(__Data, dim_calendario[MesAnoNumero] = __MaxNumero), 
			    dim_calendario[MesAnoNome]
			)
			
			VAR __Texto =
			"Lideram as exportações acumuladas no período de "
			& __MinNome & " - " & __MaxNome
			
			RETURN
			__Texto
			```
		displayFolder: Medidas\07. Storytelling
		lineageTag: 1b1c7fc9-e1e7-4821-ba56-c3e2943d453f

	measure 'P - Titulo Produto Mais Importado' =
			
			"...e " & [P - Produto Mais Importado]
