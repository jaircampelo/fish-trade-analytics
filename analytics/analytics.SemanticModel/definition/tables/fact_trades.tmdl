table fact_trades
	lineageTag: 285c657e-9154-4d2e-a1c6-7d79ec1130bd

	measure '$ Corrente' = [$ Exportacoes] + [$ Importacoes]
		displayFolder: Medidas\01. Valor
		lineageTag: 317ecf7d-40d9-4333-a168-ba67e8726581

		formatStringDefinition =
				VAR __Valor = SELECTEDMEASURE()
				VAR __Formato =
				SWITCH(
				    TRUE(),
				    __Valor > 1000000000, "#0,,,.00 Bi",
				    __Valor > 1000000, "#0,,.00 Mi",
				    __Valor > 1000, "#0,.00 K",
				    "#0"
				)
				RETURN
				__Formato

	measure '$ Exportacoes' =
			
			CALCULATE(
			    SUM(fact_trades[fob_value]),
			    fact_trades[trade_flag] = "exp"
			)
		displayFolder: Medidas\01. Valor
		lineageTag: a90ac50b-1aa3-405c-811d-62a877a67aca

		formatStringDefinition =
				VAR __Valor = SELECTEDMEASURE()
				VAR __Formato =
				SWITCH(
				    TRUE(),
				    __Valor > 1000000000, "#0,,,.00 Bi",
				    __Valor > 1000000, "#0,,.00 Mi",
				    __Valor > 1000, "#0,.00 K",
				    "#0"
				)
				RETURN
				__Formato

	measure '$ Importacoes' =
			
			CALCULATE(
			    SUM(fact_trades[fob_value]),
			    fact_trades[trade_flag] = "imp"
			)
		displayFolder: Medidas\01. Valor
		lineageTag: e0676381-f298-48a0-973e-f8961148ee11

		formatStringDefinition =
				VAR __Valor = SELECTEDMEASURE()
