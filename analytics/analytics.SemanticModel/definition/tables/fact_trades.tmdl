	measure '$ Exportacoes Acc' =
			
			CALCULATE(
			    [$ Exportacoes],
			    dim_calendario[Data] <= MAX(dim_calendario[Data])
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Medidas\06. Time Intelligence
		lineageTag: 146b0a9f-7f85-48d2-8505-87e2d8e9328d

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

