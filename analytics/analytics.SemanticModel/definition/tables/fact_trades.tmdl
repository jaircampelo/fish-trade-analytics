		lineageTag: 317ecf7d-40d9-4333-a168-ba67e8726581

		formatStringDefinition =
				VAR __Valor = SELECTEDMEASURE()
				VAR __Formato =
				SWITCH(
				    TRUE(),
				    __Valor > 1000000000, "#0,,,.00 Bi",
				    __Valor > 1000000, "#0,,.00 Mi",
				    __Valor > 1000, "#0,.00 K",
				    "#0"
				)
				RETURN
				__Formato

