	measure '# Qtd Parceiros Exportacoes' =
			
			CALCULATE(
			    DISTINCTCOUNT(fact_trades[trade_country_id]),
			    fact_trades[trade_flag] = "exp"
			)
		formatString: 0
		displayFolder: Medidas\02. Volume
		lineageTag: d7ae89a7-5d4e-4f83-b7fd-c4fe31b944d3

	measure '# Qtd Parceiros Importacoes' =
			
			CALCULATE(
			    DISTINCTCOUNT(fact_trades[trade_country_id]),
			    fact_trades[trade_flag] = "imp"
			)
		formatString: 0
		displayFolder: Medidas\02. Volume
		lineageTag: a6c7e583-7cde-4e03-bc02-85ee170151fc

	measure 'Top N % Exportacoes Paises Parceiros' =
			
			VAR __TopN =
			TOPN(
			    [TopN Value],
			    ALL(aux_paises_outros),
			    [% Participacao no Total Exportacoes], DESC
			)
			
			VAR __ExpTopN =
			CALCULATE(
			    [% Participacao no Total Exportacoes],
			    KEEPFILTERS(__TopN)
			)
			
			VAR __Outros =
			EXCEPT(ALL(aux_paises_outros), __TopN)
			
			VAR __ExpOutros =
			CALCULATE(
			    [% Participacao no Total Exportacoes],
			    __Outros
			)
			
			VAR __Result =
			IF(
			    SELECTEDVALUE(aux_paises_outros[country_name]) = "Outros",
			    __ExpOutros,
			    __ExpTopN
			)
			
			RETURN
			__Result
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Medidas\04. Rankings
		lineageTag: eb82da6a-5d3d-4e4f-9893-2615f5df18a6

