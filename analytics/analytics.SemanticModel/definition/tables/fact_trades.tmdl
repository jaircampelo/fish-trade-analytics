		lineageTag: 5858aa8a-e4fa-4710-93ef-32d7b0dab8f5

	measure 'P - Titulo Produto Maior Valor Agregado' =
			
			"...mas " & [P - Produto Maior Valor Agregado Exportacoes]
		displayFolder: Medidas\07. Storytelling
		lineageTag: 6b8bc1d9-d5e2-414c-9d0a-d29b124c335c

	measure 'P - Subtitulo Produto Maior Valor Agregado' =
			
			VAR __Top1Exp =
			TOPN(
			    1,
			    ALLSELECTED(dim_product_categories[product_category_name]),
			    [$ Exportacoes], DESC
			)
			VAR __Top1ValorPorQuilo =
			TOPN(
			    1,
			    ALLSELECTED(dim_product_categories[product_category_name]),
			    [$ Preco Medio por Quilo Exportacoes], DESC
			)
			
			VAR __ValorTop1Exp =
			CALCULATE(
			    [$ Preco Medio por Quilo Exportacoes],
			    __Top1Exp
			)
			VAR __ValorTop1PorQuilo =
			CALCULATE(
			    [$ Preco Medio por Quilo Exportacoes],
			    __Top1ValorPorQuilo
			)
			
			VAR __Relacao =
			DIVIDE(__ValorTop1PorQuilo, __ValorTop1Exp)
			
			VAR __Texto =
			"É a categoria de maior valor agregado, valendo "
			& FORMAT(__Relacao, "#0x")
			& " mais por quilo."
			
			RETURN
			__Texto
		displayFolder: Medidas\07. Storytelling
		lineageTag: 67acff90-de02-4c00-82da-5fc942116919

	measure 'P - Subtitulo Exportacoes por Categoria' = ```
			
			-- CRIA UMA TABELA MOSTRANDO A TOP 1 CATEGORIA DE CADA ANO NAS EXPORTAÇÕES
			VAR __TabTop1Anos =
			ADDCOLUMNS(
			    ALLSELECTED(dim_calendario[Ano]),
			    "@Top1Cat",
			    CONCATENATEX(
			        TOPN(
			            1,
			            ALLSELECTED(dim_product_categories[product_category_name]),
			            [$ Exportacoes], DESC
			        ),
			        dim_product_categories[product_category_name]
			    )
			)
			
			-- RETORNA O LÍDER DE COMÉRCIO NO ANO MAIS RECENTE
			VAR __AnoMaisRecente =
			MAXX(__TabTop1Anos, dim_calendario[Ano])
			VAR __Top1CatRecente =
			MAXX(
			    FILTER(__TabTop1Anos, dim_calendario[Ano] = __AnoMaisRecente),
			    [@Top1Cat]
			)
			
			-- RETORNA A QUANTO TEMPO O LÍDER MAIS RECENTE ESTÁ NO TOPO
			VAR __AnoMaisRecenteSemTop1 =
			MAXX(
			    FILTER(__TabTop1Anos, [@Top1Cat] <> __Top1CatRecente),
			    dim_calendario[Ano]
			)
			VAR __PeriodoLideranca =
			__AnoMaisRecente - __AnoMaisRecenteSemTop1
			
			-- RETORNA O VALOR DO COMÉRCIO ACUMULADO DO TOP 1 MAIS RECENTE
			VAR __Acc =
			CALCULATE(
			    [$ Exportacoes Acc],
			    FILTER(
			        dim_product_categories,
			        dim_product_categories[product_category_name] = __Top1CatRecente
			    )
			)
			VAR __FormatAcc =
			SWITCH(
			    TRUE(),
			    ABS(__Acc) > 1000000000, FORMAT(__Acc, "#0,,,.00 Bi"),
			    ABS(__Acc) > 1000000, FORMAT(__Acc, "#0,,.00 Mi"),
			    ABS(__Acc) > 1000, FORMAT(__Acc, "#0,.00 K"),
			    FORMAT(__Acc, "#0")
			)
			
			-- RETORNA A DATA MÍNIMA E MÁXIMA DO PERÍODO SELECIONADO NOS FILTROS
			VAR __Data =
			ALLSELECTED(dim_calendario[MesAnoNome], dim_calendario[MesAnoNumero])
			VAR __MinNumero = 
			MINX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendario[MesAnoNumero]
			)
			VAR __MaxNumero = 
			MAXX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendario[MesAnoNumero]
			)
			VAR __MinNome = 
			MAXX(
			    FILTER(__Data, dim_calendario[MesAnoNumero] = __MinNumero), 
			    dim_calendario[MesAnoNome]
			)
			VAR __MaxNome = 
			MAXX(
			    FILTER(__Data, dim_calendario[MesAnoNumero] = __MaxNumero), 
			    dim_calendario[MesAnoNome]
			)
			
			RETURN
			__Top1CatRecente
			& " lideram as exportações há "
			& __PeriodoLideranca
			& " anos consecutivos e acumularam "
			& __FormatAcc
			& " entre "
			& __MinNome & " - " & __MaxNome & "."
			```
		displayFolder: Medidas\07. Storytelling
		lineageTag: e344f7b0-0d5a-4d93-b0a1-2fef0e4ba4e0

	measure 'P - Subtitulo Preco por Quilo Anual Exportacoes' =
			
			VAR __Media =
			CALCULATE(
			    [$ Preco Medio por Quilo Exportacoes],
			    ALLSELECTED(dim_calendario[Ano])
			)
			VAR __PicoValor =
			MAXX(
			    ALLSELECTED(dim_calendario[Ano]),
			    [$ Preco Medio por Quilo Exportacoes]
			)
			VAR __PicoAno =
			CONCATENATEX(
			    TOPN(
			        1,
			        ALLSELECTED(dim_calendario[Ano]),
			        [$ Preco Medio por Quilo Exportacoes], DESC
			    ),
			    dim_calendario[Ano]
			)
			
			RETURN
			"Média geral de "
			& FORMAT(__Media, "#0.00 U$/kg")
			& " e pico de "
			& FORMAT(__PicoValor, "#0.00 U$/kg")
			& " no ano de "
			& __PicoAno & "."
