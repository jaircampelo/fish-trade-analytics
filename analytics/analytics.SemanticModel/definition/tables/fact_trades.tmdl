	measure '% Preco Medio por Quilo Exportacoes YoY' =
			
			VAR __Ly = [$ Preco Medio por Quilo Exportacoes LY]
			
			VAR __Result = DIVIDE([$ Preco Medio por Quilo Exportacoes] - __Ly, __Ly)
			
			RETURN
			__Result
