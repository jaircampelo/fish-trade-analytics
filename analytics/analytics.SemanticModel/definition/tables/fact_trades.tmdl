	partition fact_trades = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database("localhost", "datawarehouse"),
				    gold_fact_trades = Fonte{[Schema="gold",Item="fact_trades"]}[Data],
				    outrasColunasRemovidas = Table.SelectColumns(gold_fact_trades,{"trade_date", "city_id", "trade_country_id", "product_category_id", "fob_value", "fob_value_real", "net_weight", "trade_flag"})
				in
				    outrasColunasRemovidas

