	measure 'PC - Titulo Card Exportacoes' =
			
			VAR __CategoriasSelecionadas = VALUES(dim_product_categories[product_category_name])
			VAR __QtdSelecionadas = COUNTROWS(__CategoriasSelecionadas)
			VAR __UmaCategoria = SELECTEDVALUE(dim_product_categories[product_category_name])
			
			VAR __TabComPct =
			ADDCOLUMNS(
			    ALLSELECTED(dim_countries[country_name]),
			    "@Pct",
			    CALCULATE([% Participacao no Total Exportacoes])
			)
			VAR __Top1Pct =
			MAXX(
			    TOPN(1, __TabComPct, [@Pct], DESC),
			    [@Pct]
			)
			
			RETURN
			SWITCH(
			    TRUE(),
			    __QtdSelecionadas = COUNTROWS(ALL(dim_product_categories[product_category_name])),
			        "Destino de " & FORMAT(__Top1Pct, "#0.00%") & " de tudo que o Brasil exporta em pescado",
			    __QtdSelecionadas = 1,
			        "Destino de " & FORMAT(__Top1Pct, "#0.00%") & " de tudo que o Brasil exporta em " & __UmaCategoria,
			    "Destino de " & FORMAT(__Top1Pct, "#0.00%") & " de tudo que o Brasil exporta para as categorias selecionadas"
			)
		displayFolder: Medidas\07. Storytelling
		lineageTag: 25ae6151-c1e2-46a3-999f-f84f367507ec

