	measure '$ Preco Medio por Quilo Exportacoes' = DIVIDE([$ Exportacoes], [# Peso Líquido Exportacoes])
		displayFolder: Medidas\03. Performance & Preço
		lineageTag: 3eaa3fb0-33cf-4c11-9577-b8da2d194ec0

		formatStringDefinition = "#,0.00;#,0.00;#,0.00"

	measure '% Participacao no Total Exportacoes' =
			
			VAR __Total =
			CALCULATE(
			    [$ Exportacoes],
			    ALLSELECTED(fact_trades)
			)
			
			VAR __Result = DIVIDE([$ Exportacoes], __Total)
			
			RETURN
			__Result
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Medidas\03. Performance & Preço
		lineageTag: 025c80d1-c2ee-4b96-b7ab-75f0efdcd968

	measure '% Taxa de Cobertura' = DIVIDE([$ Exportacoes], [$ Importacoes])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Medidas\03. Performance & Preço
		lineageTag: 540b50da-7533-4ce0-bf13-cb8111333819

	measure 'Ranking Exportacoes por Estado' =
			
			VAR __Rank =
			RANK(
			    DENSE,
			    ALLSELECTED(dim_cities[state_name]),
			    ORDERBY([$ Exportacoes], DESC)
			)
			
			RETURN
			__Rank
		formatString: 0
		displayFolder: Medidas\04. Rankings
		lineageTag: 6ce5d103-ce7e-4114-b585-0f184742de1c

	measure 'Top N Municipios Exportacoes' =
			
			VAR __TopN =
			TOPN(
			    [TopN Value],
			    ALL(dim_cities[city_uf]),
			    [$ Exportacoes], DESC
			)
			
			VAR __Result = 0
			
			RETURN
			CALCULATE(
			    [$ Exportacoes],
			    KEEPFILTERS(__TopN)
			)
		displayFolder: Medidas\04. Rankings
		lineageTag: a74cea51-dc20-4c93-a4cd-f9dc59fd671b

		formatStringDefinition =
