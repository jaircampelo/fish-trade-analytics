			VAR __Result =
			SWITCH(
			    TRUE(),
			    __Variacao > 0, FORMAT(__Variacao, "+0.0") & " p.p.",
			    __Variacao < 0, FORMAT(__Variacao, "-0.0") & " p.p.",
			    FORMAT(__Variacao, "0.0") & " p.p."
