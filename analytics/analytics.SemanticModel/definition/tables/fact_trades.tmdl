	measure 'Top N % HHI Estado Exportacoes' =
			
			VAR __TopN =
			TOPN(
			    [TopN Value],
			    ALL(aux_estados_outros),
			    [% HHI Estado Exportacoes], DESC
			)
			
			VAR __ExpTopN =
			CALCULATE(
			    [% HHI Estado Exportacoes],
			    KEEPFILTERS(__TopN)
			)
			
			VAR __Outros =
			EXCEPT(ALL(aux_estados_outros), __TopN)
			
			VAR __ExpOutros =
			CALCULATE(
			    [% HHI Estado Exportacoes],
			    __Outros
			)
			
			VAR __Result =
			IF(
			    SELECTEDVALUE(aux_estados_outros[state_name]) = "Outros",
			    __ExpOutros,
			    __ExpTopN
			)
			
			RETURN
			__Result
		formatString: 0.00%;-0.00%;0.00%
