	measure '$ Corrente LY' =
			
			CALCULATE(
			    [$ Corrente],
			    SAMEPERIODLASTYEAR(dim_calendario[Data])
			)
		displayFolder: Medidas\06. Time Intelligence
		lineageTag: 40703011-1d1c-4290-9e73-0787f42acdbf

		formatStringDefinition =
				VAR __Valor = SELECTEDMEASURE()
				VAR __Formato =
				SWITCH(
				    TRUE(),
				    __Valor > 1000000000, "#0,,,.00 Bi",
				    __Valor > 1000000, "#0,,.00 Mi",
				    __Valor > 1000, "#0,.00 K",
				    "#0"
				)
				RETURN
				__Formato

	measure '% Corrente YoY' =
			
			VAR __Ly = [$ Corrente LY]
			
			VAR __Result = DIVIDE( [$ Corrente] - __Ly, __Ly)
			
			RETURN
			__Result
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Medidas\06. Time Intelligence
		lineageTag: bd54c39b-f3fb-4877-b391-082cf965cd20

