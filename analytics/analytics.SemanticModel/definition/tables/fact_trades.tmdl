	measure '% Exportacoes YoY' =
			
			VAR __Ly = [$ Exportacoes]
			
			VAR __Result = DIVIDE( [$ Exportacoes] - __Ly, __Ly)
			
			RETURN
			__Result
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Medidas\06. Time Intelligence
		lineageTag: e029035d-8189-40d8-947e-91ded8160dc1

	measure '% Importacoes YoY' =
			
			VAR __Ly = [$ Importacoes]
			
