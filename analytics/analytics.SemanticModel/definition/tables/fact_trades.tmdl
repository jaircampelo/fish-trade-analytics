	measure '$ Balança Comercial' = [$ Exportacoes] - [$ Importacoes]
		displayFolder: Medidas\03. Performance & Preço
		lineageTag: 507bec1c-18ff-4d6e-af4a-67811d9b2cd8

		formatStringDefinition =
				VAR __Valor = SELECTEDMEASURE()
				VAR __Formato =
				SWITCH(
				    TRUE(),
				    __Valor = 0, "0",
				    __Valor > 1000000000, "#0,,,.00 Bi",
				    __Valor < -1000000000, "#0,,,.00 Bi",
				    __Valor > 1000000, "#0,,.00 Mi",
				    __Valor < -1000000, "#0,,.00 Mi",
				    __Valor > 1000, "#0,.00 K",
				    __Valor < -1000, "#0,.00 K",
				    "#0"
				)
				RETURN
				__Formato

	measure '# Peso Líquido Exportacoes' =
			
			CALCULATE(
			    SUM(fact_trades[net_weight]),
			    fact_trades[trade_flag] = "exp"
			)
		displayFolder: Medidas\02. Volume
		lineageTag: 0e7e4ce6-7ccf-43cc-8d1f-5143ef98747e

