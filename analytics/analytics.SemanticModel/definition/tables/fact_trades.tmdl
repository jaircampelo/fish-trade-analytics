	measure '$ Exportacoes Real' =
			
			CALCULATE(
			    SUM(fact_trades[fob_value_real]),
			    fact_trades[trade_flag] = "exp"
			)
		displayFolder: Medidas\05. Valor Real
		lineageTag: 8f8a147e-39f3-4631-8bba-1dfd92bf8f64

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Dados Disponiveis' =
			
			VAR __MinData =
			    CALCULATE(
			        MIN(fact_trades[trade_date]),
			        ALL(fact_trades)
			    )
			VAR __MaxData =
			    CALCULATE(
			        MAX(fact_trades[trade_date]),
			        ALL(fact_trades)
			    )
			
			RETURN
			"Dados disponíveis de "
			& FORMAT(__MinData, "mmm/yyyy")
			& " a "
			& FORMAT(__MaxData, "mmm/yyyy")
		displayFolder: Medidas\07. Storytelling
		lineageTag: 1ef59376-5a91-46f0-af51-c6321f8a73c2

