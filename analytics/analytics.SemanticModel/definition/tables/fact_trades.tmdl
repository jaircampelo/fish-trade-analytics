	measure 'Top N Municipios Exportacoes' =
			
			VAR __TopN =
			TOPN(
			    [TopN Value],
			    ALL(dim_cities[city_uf]),
			    [$ Exportacoes], DESC
			)
			
			VAR __Result =
			CALCULATE(
			    [$ Exportacoes],
			    KEEPFILTERS(__TopN)
			)
			
			RETURN
			__Result
